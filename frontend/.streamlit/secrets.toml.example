# Copy this file to secrets.toml for local Streamlit-only runs.
# Do not commit frontend/.streamlit/secrets.toml.

DATABASE_URL = "sqlite:///./kilele.db"
API_BASE_URL = "http://localhost:8000"
ENVIRONMENT = "development"
DEBUG = "True"

# Optional one-time initial admin bootstrap.
# Prefer registering in the app and running frontend/make_admin.py from a trusted shell.
# If you use these values in hosted production, remove them after the first successful seed.
# INITIAL_ADMIN_USERNAME = ""
# INITIAL_ADMIN_EMAIL = ""
# INITIAL_ADMIN_PASSWORD = ""
# INITIAL_ADMIN_FULL_NAME = ""

# Optional production values:
# CLOUDINARY_CLOUD_NAME = ""
# CLOUDINARY_API_KEY = ""
# CLOUDINARY_API_SECRET = ""
# SENTRY_DSN = ""
