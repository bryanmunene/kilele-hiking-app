# Kilele Hiking App Environment Variables
# Copy this to .env for local Docker/production-like runs and fill in real values.

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Local single-service development (SQLite)
DATABASE_URL=sqlite:///./kilele.db

# Production (PostgreSQL) - Uncomment and use one of these:
# Neon (Free tier): postgresql://user:password@ep-xxx.neon.tech/kilele
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Railway: postgresql://user:password@containers-us-west-xxx.railway.app:5432/railway
# DATABASE_URL=postgresql://username:password@host:port/database_name

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# Secret key for JWT/session signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Session token expiry (days)
SESSION_EXPIRY_DAYS=30

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Optional one-time initial admin bootstrap.
# Prefer registering in the app and running frontend/make_admin.py from a trusted shell.
# If you use these values in hosted production, remove them after the first successful seed.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_FULL_NAME=

# ============================================
# CLOUDINARY IMAGE STORAGE
# ============================================
# Sign up at https://cloudinary.com (free tier: 25GB storage, 25GB bandwidth)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# EMAIL SERVICE (SendGrid)
# ============================================
# Sign up at https://sendgrid.com (free tier: 100 emails/day)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@kilele.app
SUPPORT_EMAIL=support@kilele.app

# Alternative: SMTP (Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@kilele.app

# ============================================
# ERROR TRACKING (Sentry)
# ============================================
# Sign up at https://sentry.io (free tier: 5k errors/month)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL (update after deployment)
API_BASE_URL=http://localhost:8000
# Production: https://your-api.railway.app or https://your-api.onrender.com

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,https://your-app.streamlit.app

# Public port is supplied by most cloud hosts. The Dockerfiles default to 8000
# for FastAPI and 8501 for Streamlit when PORT is not set.
# PORT=8000

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (set to False in production)
DEBUG=True

# App timezone
TIMEZONE=Africa/Nairobi

# Max upload size (MB)
MAX_UPLOAD_SIZE_MB=10

# ============================================
# RATE LIMITING
# ============================================
# API rate limits (requests per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=60
RATE_LIMIT_UPLOAD=10

# ============================================
# BACKUP CONFIGURATION
# ============================================
# S3 bucket for database backups (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BACKUP_BUCKET=kilele-backups
# AWS_REGION=us-east-1

# ============================================
# ANALYTICS (Optional)
# ============================================
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_2FA=True
ENABLE_WEARABLES=True
ENABLE_SOCIAL=True
ENABLE_MESSAGING=True
ENABLE_ACHIEVEMENTS=True

# ============================================
# STRAVA INTEGRATION (Optional)
# ============================================
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8501/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-this-token

# ============================================
# M-PESA INTEGRATION (Optional)
# ============================================
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/mpesa/callback
